# Copy to .env and fill in. .env is git-ignored.

# HMAC key for signing JWTs: at least 32 characters, keep it secret.
# Generate one with: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Default admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator
